<Window x:Class="GlanceNext.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GlanceNext">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root" Background="{ThemeResource CardBrush}">
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Margin="20,0,150,0" VerticalAlignment="Stretch">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE72E;" FontSize="17" Foreground="{ThemeResource AccentTextBrush}" />
        <TextBlock Text="GlanceNext" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Text=" /  更从容的数字空间" Foreground="{ThemeResource MutedBrush}" FontSize="12" />
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" ExpandedModeThresholdWidth="880" CompactModeThresholdWidth="560" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="220" IsPaneToggleButtonVisible="False" SelectionChanged="NavigationChanged">
      <NavigationView.PaneHeader>
        <StackPanel Margin="24,28,16,30" Spacing="6">
          <Border Width="42" Height="42" HorizontalAlignment="Left" CornerRadius="13" Background="{ThemeResource AccentSoftBrush}" Margin="0,0,0,10"><FontIcon Glyph="&#xE72E;" Style="{StaticResource AccentIcon}" /></Border>
          <TextBlock Text="GlanceNext" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="专注当下，守护隐私" Style="{StaticResource BodyMuted}" />
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="概览" Tag="overview"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="隐私保护" Tag="privacy"><NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="设备与校准" Tag="device"><NavigationViewItem.Icon><FontIcon Glyph="&#xE722;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Margin="24,20,20,28" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="6" Height="6" Fill="{ThemeResource AccentTextBrush}" VerticalAlignment="Center" /><TextBlock Text="仅红外 · 全程本地" FontSize="12" Foreground="{ThemeResource MutedBrush}" /></StackPanel>
          <TextBlock Text="GlanceNext  /  0.1.1" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
        </StackPanel>
      </NavigationView.PaneFooter>
      <ScrollViewer x:Name="PageScroller" Background="{ThemeResource PageBrush}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,28,32,32" MaxWidth="1240" HorizontalAlignment="Stretch">
          <StackPanel x:Name="OverviewPage" Spacing="22">
            <StackPanel Spacing="5"><TextBlock Text="你的空间，由你掌控。" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="让保护安静发生，把注意力留给重要的事。" Style="{StaticResource BodyMuted}" /></StackPanel>
            <Border Background="{ThemeResource HeroBrush}" CornerRadius="20" Padding="28">
              <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="12">
                  <TextBlock Text="PROTECTION STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" CharacterSpacing="120" />
                  <TextBlock Text="{Binding StatusTitle}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource BodyMuted}" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <Button Content="诊断与校准" Style="{StaticResource GlanceAccentButtonStyle}" Click="OpenDiagnostics" />
                    <Button Content="{Binding PauseLabel}" Click="PauseClicked" IsEnabled="{Binding CanToggleDetection}" />
                  </StackPanel>
                </StackPanel>
                <FontIcon Grid.Column="1" Glyph="&#xEA18;" FontSize="80" Opacity="0.18" Foreground="{ThemeResource AccentTextBrush}" Margin="12,0,10,0" />
              </Grid>
            </Border>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}" Padding="20"><StackPanel Spacing="9"><TextBlock Text="设备状态" Style="{StaticResource BodyMuted}" /><TextBlock Text="{Binding ReadinessSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding FpsText}" Foreground="{ThemeResource AccentTextBrush}" /></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20"><StackPanel Spacing="9"><TextBlock Text="保护功能" Style="{StaticResource BodyMuted}" /><TextBlock Text="{Binding EnabledSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding ProtectionSummary}" Style="{StaticResource BodyMuted}" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20"><StackPanel Spacing="9"><TextBlock Text="离席锁屏" Style="{StaticResource BodyMuted}" /><TextBlock Text="{Binding CountdownText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="断流不会触发锁屏" Style="{StaticResource BodyMuted}" /></StackPanel></Border>
            </Grid>
            <TextBlock Text="让每一项保护，都恰到好处" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
            <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="12" Height="44"><FontIcon Glyph="&#xE72E;" Style="{StaticResource AccentIcon}" /></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="离席保护" Style="{StaticResource SectionTitle}" /><TextBlock Text="离开后自动锁屏，回到座位后使用 Windows 正常登录。" Style="{StaticResource BodyMuted}" /></StackPanel><ToggleSwitch Grid.Column="2" IsOn="{Binding PresenceEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEnablePresence}" OffContent="关闭" OnContent="开启" AutomationProperties.Name="离席保护" /></Grid></Border>
            <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="12" Height="44"><FontIcon Glyph="&#xE890;" Style="{StaticResource AccentIcon}" /></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="旁观者提醒" Style="{StaticResource SectionTitle}" /><TextBlock Text="画面中出现第二个人时提醒你，也可选择自动遮罩。" Style="{StaticResource BodyMuted}" /></StackPanel><ToggleSwitch Grid.Column="2" IsOn="{Binding BystanderEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEnableBystander}" OffContent="关闭" OnContent="开启" AutomationProperties.Name="旁观者提醒" /></Grid></Border>
            <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="12" Height="44"><FontIcon Glyph="&#xE7F4;" Style="{StaticResource AccentIcon}" /></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="智能屏幕" Style="{StaticResource SectionTitle}" /><TextBlock Text="看向别处时柔和调暗，恢复正视后立即解除。" Style="{StaticResource BodyMuted}" /></StackPanel><ToggleSwitch Grid.Column="2" IsOn="{Binding AttentionEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEnableAttention}" OffContent="关闭" OnContent="开启" AutomationProperties.Name="智能屏幕" /></Grid></Border>
          </StackPanel>

          <StackPanel x:Name="PrivacyPage" Spacing="22" Visibility="Collapsed">
            <StackPanel Spacing="5"><TextBlock Text="隐私保护" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="调节触发时机，让保护适应你的工作节奏。" Style="{StaticResource BodyMuted}" /></StackPanel>
            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Title="先验证，再启用" Message="请先在「设备与校准」检查红外画面、完成功能验证。未通过的功能会保持关闭。" />
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="18">
              <Grid><TextBlock Text="离席锁屏" Style="{StaticResource SectionTitle}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding PresenceEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEnablePresence}" OffContent="关闭" OnContent="开启" AutomationProperties.Name="离席锁屏" /></Grid>
              <TextBlock Text="连续未检测到人脸后锁定当前 Windows 会话。画面中有人不等于已确认是你本人。" Style="{StaticResource BodyMuted}" />
              <NumberBox Header="离席等待时间（秒）" Value="{Binding AbsenceSeconds, Mode=TwoWay}" Minimum="10" Maximum="600" SpinButtonPlacementMode="Inline" Width="240" HorizontalAlignment="Left" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="18">
              <Grid><TextBlock Text="旁观者提醒" Style="{StaticResource SectionTitle}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding BystanderEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEnableBystander}" OffContent="关闭" OnContent="开启" AutomationProperties.Name="旁观者提醒设置" /></Grid>
              <TextBlock Text="第二个人持续出现 1 秒后提醒，人数恢复正常 2 秒后解除。" Style="{StaticResource BodyMuted}" />
              <CheckBox Content="提醒时自动遮罩屏幕" IsChecked="{Binding MaskOnBystander, Mode=TwoWay}" />
              <TextBlock Text="遮罩可通过紧急快捷键解除，并暂停检测。" Style="{StaticResource BodyMuted}" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="18">
              <Grid><TextBlock Text="智能屏幕" Style="{StaticResource SectionTitle}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding AttentionEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEnableAttention}" OffContent="关闭" OnContent="开启" AutomationProperties.Name="智能屏幕设置" /></Grid>
              <TextBlock Text="根据头部朝向近似判断注意力，只控制主显示器。请先完成正视和转头校准。" Style="{StaticResource BodyMuted}" />
              <NumberBox Header="看向别处后延迟（秒）" Value="{Binding AttentionSeconds, Mode=TwoWay}" Minimum="1" Maximum="30" SpinButtonPlacementMode="Inline" Width="240" HorizontalAlignment="Left" />
              <Slider Header="调暗强度" Minimum="0.2" Maximum="0.85" StepFrequency="0.05" Value="{Binding DimOpacity, Mode=TwoWay}" Width="340" HorizontalAlignment="Left" />
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="DevicePage" Spacing="22" Visibility="Collapsed">
            <StackPanel Spacing="5"><TextBlock Text="设备与校准" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="先确认看得清，再让保护可靠发生。" Style="{StaticResource BodyMuted}" /></StackPanel>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16">
              <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox Header="独立红外摄像头" ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding CanSelectDevice}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="刷新设备" Click="RefreshClicked" IsEnabled="{Binding CanSelectDevice}" VerticalAlignment="Bottom" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="{Binding StartButtonText}" Style="{StaticResource GlanceAccentButtonStyle}" Click="StartClicked" IsEnabled="{Binding CanStart}" /><Button Content="停止并释放摄像头" Click="StopClicked" IsEnabled="{Binding CanStop}" /></StackPanel>
              <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource BodyMuted}" />
              <Border Background="#0F1719" CornerRadius="12" Height="280">
                <Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><FontIcon Glyph="&#xE722;" FontSize="32" Foreground="#77938E" /><TextBlock Text="红外实时预览 · 不保存画面" Foreground="#9DB4AE" FontSize="13" /></StackPanel><Image Source="{Binding Preview}" Stretch="Uniform" /></Grid>
              </Border>
              <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock Text="检测速率" Style="{StaticResource BodyMuted}" /><TextBlock Text="{Binding FpsText}" FontSize="17" FontWeight="SemiBold" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="人脸数量" Style="{StaticResource BodyMuted}" /><TextBlock Text="{Binding FaceCountText}" FontSize="17" FontWeight="SemiBold" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="头部朝向" Style="{StaticResource BodyMuted}" /><TextBlock Text="{Binding PoseText}" FontSize="15" TextWrapping="Wrap" /></StackPanel>
              </Grid>
              <TextBlock Text="{Binding DeviceFormat}" Style="{StaticResource BodyMuted}" /><TextBlock Text="{Binding ValidationText}" Foreground="{ThemeResource AccentTextBrush}" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="01 / 校准注意力" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding CalibrationInstruction}" Style="{StaticResource BodyMuted}" /><Button Content="{Binding CalibrationButtonText}" Click="CalibrateClicked" IsEnabled="{Binding CanCalibrate}" HorizontalAlignment="Left" /><TextBlock Text="{Binding CalibrationSummary}" Foreground="{ThemeResource AccentTextBrush}" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="02 / 确认提醒方向" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding DirectionInstruction}" Style="{StaticResource BodyMuted}" /><Button Content="确认左右方向" Click="DirectionClicked" IsEnabled="{Binding CanCalibrateDirection}" HorizontalAlignment="Left" /><TextBlock Text="{Binding DirectionSummary}" Foreground="{ThemeResource AccentTextBrush}" /></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="03 / 实机验证" Style="{StaticResource SectionTitle}" /><TextBlock Text="分别观察正常光线、弱光、戴眼镜和转头场景。完成相应观察后，勾选你已确认可靠的功能。勾选不会自动开启保护。" Style="{StaticResource BodyMuted}" />
              <CheckBox IsChecked="{Binding PresenceVerified, Mode=TwoWay}" IsEnabled="{Binding CanVerifyPresence}"><TextBlock Text="已确认在座能检测到人脸，离席后人脸消失" TextWrapping="Wrap" /></CheckBox>
              <CheckBox IsChecked="{Binding BystanderVerified, Mode=TwoWay}" IsEnabled="{Binding CanVerifyBystander}"><TextBlock Text="已确认第二个人进入时能稳定检测到两个人" TextWrapping="Wrap" /></CheckBox>
              <CheckBox IsChecked="{Binding AttentionVerified, Mode=TwoWay}" IsEnabled="{Binding CanVerifyAttention}"><TextBlock Text="已确认转头与恢复正视的注意力判断正确" TextWrapping="Wrap" /></CheckBox>
              <TextBlock Text="相应场景尚未出现在有效红外画面中时，验证选项不可勾选。" Style="{StaticResource BodyMuted}" />
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="SettingsPage" Spacing="22" Visibility="Collapsed">
            <StackPanel Spacing="5"><TextBlock Text="设置" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="轻量常驻，按你的习惯运行。" Style="{StaticResource BodyMuted}" /></StackPanel>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="20"><TextBlock Text="外观与启动" Style="{StaticResource SectionTitle}" />
              <ComboBox Header="界面主题" SelectedValuePath="Tag" SelectedValue="{Binding Theme, Mode=TwoWay}" Width="280"><ComboBoxItem Content="跟随系统" Tag="System" /><ComboBoxItem Content="浅色" Tag="Light" /><ComboBoxItem Content="深色" Tag="Dark" /></ComboBox>
              <ToggleSwitch Header="登录 Windows 后启动" IsOn="{Binding StartWithWindows, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
              <TextBlock Text="关闭窗口后进入托盘。右键托盘图标可打开、暂停、恢复或退出。" Style="{StaticResource BodyMuted}" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="18"><TextBlock Text="紧急解除" Style="{StaticResource SectionTitle}" /><TextBlock Text="一键解除调暗、提醒或遮罩，并暂停检测。" Style="{StaticResource BodyMuted}" />
              <ComboBox Header="全局快捷键" SelectedValuePath="Tag" SelectedValue="{Binding EmergencyShortcut, Mode=TwoWay}" Width="280"><ComboBoxItem Content="Ctrl + Alt + G" Tag="Ctrl+Alt+G" /><ComboBoxItem Content="Ctrl + Alt + P" Tag="Ctrl+Alt+P" /><ComboBoxItem Content="Ctrl + Shift + F12" Tag="Ctrl+Shift+F12" /></ComboBox>
              <Button Content="立即暂停并解除屏幕效果" Click="EmergencyClicked" HorizontalAlignment="Left" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="本地数据" Style="{StaticResource SectionTitle}" /><TextBlock Text="红外画面只在内存中处理。仅保存设置、校准参数和状态／错误日志，不保存视频、人脸图像或身份特征。" Style="{StaticResource BodyMuted}" /><TextBlock Text="{Binding LocalDataPath}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" /><Button Content="打开本地数据目录" Click="OpenDataClicked" HorizontalAlignment="Left" /></StackPanel></Border>
            <Button Content="退出 GlanceNext" Click="ExitClicked" HorizontalAlignment="Left" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
